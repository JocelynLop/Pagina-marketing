<div class="auth-field">
    <label class="form-label" for="{{ fieldId }}">{% if fieldId == 'confirm_password' %}Confirmar contrase&ntilde;a{% else %}Contrase&ntilde;a{% endif %}</label>
    <div class="auth-password">
        <input class="form-control form-control-lg" id="{{ fieldId }}" type="password" name="{{ fieldId }}" autocomplete="{{ autocomplete }}" {% if autocomplete == 'new-password' %}minlength="8"{% endif %} {% if hint|default(false) %}aria-describedby="password-hint"{% endif %} required>
        <button type="button" class="password-toggle" data-password-toggle aria-controls="{{ fieldId }}" aria-pressed="false" aria-label="Mostrar contrase&ntilde;a" title="Mostrar contrase&ntilde;a">
            <i class="bi bi-eye" aria-hidden="true"></i>
        </button>
    </div>
    {% if hint|default(false) %}
        <small class="auth-hint" id="password-hint">Al menos 8 caracteres, con may&uacute;scula, min&uacute;scula y n&uacute;mero.</small>
    {% endif %}
</div>
