{% extends 'base.html.twig' %}

{% block title %}Panel de publicaciones{% endblock %}

{% block body %}
<main class="admin-shell">
    <aside class="admin-sidebar">
        <a class="brand-mark" href="{{ path('app_publications') }}">Aura</a>
        <nav>
            <a class="active" href="{{ path('app_publications_manage') }}">
                <i class="bi bi-layout-text-window-reverse"></i>
                Publicaciones
            </a>
            <a href="{{ path('app_publications') }}">
                <i class="bi bi-eye"></i>
                Vista cliente
            </a>
            <form method="post" action="{{ path('app_logout') }}" class="sidebar-logout">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                <button type="submit">
                    <i class="bi bi-box-arrow-right"></i>
                    Cerrar sesion
                </button>
            </form>
        </nav>
    </aside>

    <section class="admin-content">
        <div class="admin-hero">
            <div class="admin-heading">
                <div>
                    <span class="eyebrow">Panel de usuario</span>
                    <h1>Centro de publicaciones</h1>
                    <p>Agrega contenido nuevo, revisa lo publicado y manten la pagina publica siempre fresca para tus clientes.</p>
                </div>
                <a class="btn btn-light action-button" href="{{ path('app_publications') }}">
                    <i class="bi bi-box-arrow-up-right"></i>
                    Ver pagina
                </a>
            </div>
            <div class="admin-stats">
                <article>
                    <span>{{ publications|length }}</span>
                    <p>publicacion{{ publications|length == 1 ? '' : 'es' }} activa{{ publications|length == 1 ? '' : 's' }}</p>
                </article>
                <article>
                    <span>{{ publications|filter(publication => publication.isNew)|length }}</span>
                    <p>nueva{{ publications|filter(publication => publication.isNew)|length == 1 ? '' : 's' }} en 3 dias</p>
                </article>
                <article>
                    <span>3</span>
                    <p>visibles en portada</p>
                </article>
            </div>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} shadow-sm">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        {% if errors is not empty %}
            <div class="alert alert-danger shadow-sm">
                {% for error in errors %}
                    <div>{{ error }}</div>
                {% endfor %}
            </div>
        {% endif %}

        <div class="admin-grid">
            <form class="publication-form" method="post" action="{{ path('app_publications_manage') }}" data-publication-form>
                <input type="hidden" name="_token" value="{{ csrf_token('create_publication') }}">

                <div class="form-section-title">
                    <i class="bi bi-plus-circle"></i>
                    Nueva publicacion
                </div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label" for="title">Titulo</label>
                        <input class="form-control form-control-lg" id="title" name="title" maxlength="90" required data-preview-title>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="category">Categoria</label>
                        <input class="form-control form-control-lg" id="category" name="category" maxlength="40" placeholder="General" data-preview-category>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="summary">Resumen</label>
                        <input class="form-control" id="summary" name="summary" maxlength="160" required data-preview-summary>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="content">Contenido</label>
                        <textarea class="form-control" id="content" name="content" rows="7" required></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="image_url">URL de imagen</label>
                        <input class="form-control" id="image_url" name="image_url" type="url" placeholder="https://..." data-preview-image>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button class="btn btn-dark action-button" type="submit">
                        <i class="bi bi-send"></i>
                        Publicar
                    </button>
                    <button class="btn btn-outline-secondary action-button" type="reset">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        Limpiar
                    </button>
                </div>
            </form>

            <aside class="preview-card">
                <span class="eyebrow dark">Vista previa</span>
                <h2 class="preview-heading">Asi se vera tu publicacion</h2>
                <div class="preview-image" data-preview-image-box>
                    <i class="bi bi-image"></i>
                </div>
                <div class="publication-meta mt-3">
                    <span data-preview-category-output>General</span>
                    <time>Hoy</time>
                </div>
                <h2 data-preview-title-output>Titulo de la publicacion</h2>
                <p data-preview-summary-output>El resumen aparecera aqui mientras escribes.</p>
            </aside>
        </div>

        <section class="published-list">
            <div class="section-toolbar compact">
                <div>
                    <span class="eyebrow dark">Contenido activo</span>
                    <h2>Publicaciones creadas</h2>
                </div>
                <span class="counter-pill">{{ publications|length }} total</span>
            </div>

            {% if publications is empty %}
                <div class="empty-state light">
                    <i class="bi bi-inbox"></i>
                    <h3>Sin publicaciones guardadas</h3>
                    <p>Crea la primera publicacion desde el formulario superior.</p>
                </div>
            {% else %}
                <div class="table-responsive publication-table">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Titulo</th>
                                <th>Categoria</th>
                                <th>Fecha</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for publication in publications %}
                                <tr>
                                    <td>
                                        <strong>{{ publication.title }}</strong>
                                        <span>{{ publication.summary }}</span>
                                    </td>
                                    <td>{{ publication.category }}</td>
                                    <td>{{ publication.createdAt|date('d/m/Y H:i') }}</td>
                                    <td class="text-end">
                                        <form method="post" action="{{ path('app_publications_delete', { id: publication.id }) }}" data-confirm-delete>
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_publication_' ~ publication.id) }}">
                                            <button class="btn btn-sm btn-outline-danger" type="submit" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>
    </section>
</main>
{% endblock %}
