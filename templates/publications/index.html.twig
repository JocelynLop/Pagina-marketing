{% extends 'base.html.twig' %}

{% block title %}Publicaciones para clientes{% endblock %}

{% block body %}
<main class="site-shell">
    <nav class="navbar navbar-expand-lg glass-nav fixed-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="{{ path('app_publications') }}">Aura Publica</a>
            <div class="ms-auto d-flex gap-2">
                {% if is_granted('ROLE_ADMIN') %}
                    <a class="btn btn-sm btn-outline-light" href="{{ path('app_publications_manage') }}">
                        <i class="bi bi-pencil-square"></i>
                        Administrar
                    </a>
                {% elseif app.user %}
                    <form method="post" action="{{ path('app_logout') }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button class="btn btn-sm btn-outline-light" type="submit">
                            <i class="bi bi-box-arrow-right"></i>
                            Salir
                        </button>
                    </form>
                {% else %}
                    <a class="btn btn-sm btn-outline-light" href="{{ path('app_login') }}">
                        <i class="bi bi-box-arrow-in-right"></i>
                        Entrar
                    </a>
                {% endif %}
            </div>
        </div>
    </nav>

    <section class="client-hero" data-hero-carousel>
        <div class="hero-slide active" style="background-image: url('https://images.unsplash.com/photo-1497215728101-856f4ea42174?auto=format&fit=crop&w=1800&q=80');"></div>
        <div class="hero-slide" style="background-image: url('https://images.unsplash.com/photo-1559028012-481c04fa702d?auto=format&fit=crop&w=1800&q=80');"></div>
        <div class="hero-slide" style="background-image: url('https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=1800&q=80');"></div>
        <div class="hero-overlay"></div>
        <div class="container hero-content">
            <div class="row align-items-end gy-5">
                <div class="col-lg-8">
                    <span class="eyebrow">Muro publico</span>
                    <h1>Paginas web con identidad, velocidad y presencia real.</h1>
                    <p>Convertimos ideas, marcas y servicios en experiencias digitales claras para tus clientes.</p>
                </div>
                <div class="col-lg-4">
                    <div class="hero-panel">
                        <span>{{ totalPublications }}</span>
                        <p>publicacion{{ totalPublications == 1 ? '' : 'es' }} disponible{{ totalPublications == 1 ? '' : 's' }}</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section-nav-wrap">
        <div class="container">
            <nav class="section-nav" aria-label="Navegacion de secciones">
                <a href="#quienes-somos">Quienes somos?</a>
                <a href="#publicaciones">Publicaciones</a>
                <a href="#contactanos">Contactanos</a>
                <a href="#mas-sobre-nosotros">Mas sobre nosotros</a>
            </nav>
        </div>
    </section>

    <section class="access-section">
        <div class="container">
            {% if is_granted('ROLE_ADMIN') %}
                <div class="access-banner admin-access">
                    <div>
                        <span class="eyebrow dark">Modo administrador</span>
                        <h2>Gestiona las publicaciones visibles para tus clientes.</h2>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <a class="btn btn-dark action-button" href="{{ path('app_publications_manage') }}">
                            <i class="bi bi-pencil-square"></i>
                            Crear o eliminar
                        </a>
                        <form method="post" action="{{ path('app_logout') }}">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                            <button class="btn btn-outline-dark action-button" type="submit">
                                <i class="bi bi-box-arrow-right"></i>
                                Cerrar sesion
                            </button>
                        </form>
                    </div>
                </div>
            {% elseif app.user %}
                <div class="access-banner">
                    <div>
                        <span class="eyebrow dark">Sesion iniciada</span>
                        <h2>Estas viendo las publicaciones como usuario.</h2>
                        <p>Tu cuenta no tiene permisos de administracion.</p>
                    </div>
                    <form method="post" action="{{ path('app_logout') }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button class="btn btn-outline-dark action-button" type="submit">
                            <i class="bi bi-box-arrow-right"></i>
                            Cerrar sesion
                        </button>
                    </form>
                </div>
            
            {% endif %}
        </div>
    </section>

    <section class="about-section" id="quienes-somos">
        <div class="container">
            <div class="about-grid">
                <div>
                    <span class="eyebrow dark">Quienes somos?</span>
                    <h2>Creamos sitios web para negocios que quieren verse profesionales desde el primer clic.</h2>
                    <p>Somos un equipo dedicado al diseno y desarrollo de paginas web modernas, rapidas y faciles de administrar. Cuidamos la estructura, la imagen, los textos y la experiencia para que cada proyecto comunique confianza y ayude a convertir visitantes en clientes.</p>
                </div>
                <div class="about-feature-grid">
                    <article>
                        <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=700&q=80" alt="Equipo planeando un proyecto web">
                        <h3>Estrategia visual</h3>
                        <p>Definimos una presencia clara para que tu marca se sienta propia, ordenada y memorable.</p>
                    </article>
                    <article>
                        <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=700&q=80" alt="Panel de trabajo digital">
                        <h3>Desarrollo funcional</h3>
                        <p>Construimos paginas estables, responsivas y pensadas para actualizarse sin complicaciones.</p>
                    </article>
                    <article>
                        <img src="https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&w=700&q=80" alt="Cliente revisando resultados">
                        <h3>Acompanamiento</h3>
                        <p>Te guiamos desde la idea inicial hasta la publicacion y mejora continua de tu sitio.</p>
                    </article>
                </div>
            </div>
        </div>
    </section>

    <section class="publication-section" id="publicaciones">
        <div class="container">
            <div class="section-toolbar">
                <div>
                    <span class="eyebrow dark">Actualizaciones</span>
                    <h2>Ultimas publicaciones</h2>
                </div>
                <label class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="search" data-publication-search placeholder="Buscar publicacion">
                </label>
            </div>

            {% if publications is empty %}
                <div class="empty-state">
                    <i class="bi bi-journal-richtext"></i>
                    <h3>Aun no hay publicaciones</h3>
                    <p>Cuando el usuario publique contenido, aparecera aqui para los clientes.</p>
                </div>
            {% else %}
                <div class="publication-grid" data-publication-list>
                    {% for publication in publications %}
                        <article class="publication-card" data-publication-card>
                            {% if publication.isNew %}
                                <span class="new-badge">Nueva publicacion</span>
                            {% endif %}
                            {% if publication.imageUrl %}
                                <img src="{{ publication.imageUrl }}" alt="{{ publication.title }}">
                            {% else %}
                                <div class="image-placeholder">
                                    <i class="bi bi-stars"></i>
                                </div>
                            {% endif %}
                            <div class="publication-card-body">
                                <div class="publication-meta">
                                    <span>{{ publication.category }}</span>
                                    <time datetime="{{ publication.createdAt|date('Y-m-d') }}">{{ publication.createdAt|date('d/m/Y') }}</time>
                                </div>
                                <h3>{{ publication.title }}</h3>
                                <p>{{ publication.summary }}</p>
                                <button class="btn btn-dark btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#publication-{{ publication.id }}">
                                    Leer mas
                                </button>
                            </div>
                        </article>

                        <div class="modal fade" id="publication-{{ publication.id }}" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <div>
                                            <span class="modal-category">{{ publication.category }}</span>
                                            <h2 class="modal-title fs-4">{{ publication.title }}</h2>
                                        </div>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                    </div>
                                    <div class="modal-body">
                                        {% if publication.imageUrl %}
                                            <img class="modal-publication-image" src="{{ publication.imageUrl }}" alt="{{ publication.title }}">
                                        {% endif %}
                                        <p>{{ publication.content|nl2br }}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                    <a class="publication-card see-more-card" href="{{ path('app_publications_all') }}" data-publication-card>
                        <div>
                            <i class="bi bi-grid-3x3-gap"></i>
                            <h3>Ver mas</h3>
                            <p>Explora todas las publicaciones disponibles, ordenadas desde la mas reciente.</p>
                        </div>
                    </a>
                </div>
                <p class="no-results" data-no-results hidden>No se encontraron publicaciones con esa busqueda.</p>
            {% endif %}
        </div>
    </section>

    <section class="contact-section" id="contactanos">
        <div class="container">
            <div class="contact-band">
                <div>
                    <span class="eyebrow">Contactanos</span>
                    <h2>Listo para llevar tu negocio a una web con mas presencia?</h2>
                    <p>Cuentanos que necesitas y preparamos una propuesta clara para tu pagina, catalogo, panel o sistema web.</p>
                </div>
                <a class="btn btn-light action-button" href="mailto:contacto@aurapublica.com">
                    <i class="bi bi-envelope"></i>
                    Escribir ahora
                </a>
            </div>
        </div>
    </section>

    <section class="more-section" id="mas-sobre-nosotros">
        <div class="container">
            <div class="section-toolbar">
                <div>
                    <span class="eyebrow dark">Mas sobre nosotros</span>
                    <h2>Como trabajamos</h2>
                </div>
            </div>
            <div class="process-grid">
                <article>
                    <span>01</span>
                    <h3>Escuchamos tu idea</h3>
                    <p>Entendemos tu negocio, tus clientes y el objetivo principal de la pagina.</p>
                </article>
                <article>
                    <span>02</span>
                    <h3>Disenamos la experiencia</h3>
                    <p>Organizamos contenido, visuales y secciones para que todo sea facil de recorrer.</p>
                </article>
                <article>
                    <span>03</span>
                    <h3>Publicamos y mejoramos</h3>
                    <p>Dejamos tu sitio listo y con una base preparada para crecer con nuevas funciones.</p>
                </article>
            </div>
        </div>
    </section>
</main>
{% endblock %}
