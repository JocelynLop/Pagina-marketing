<section class="modal-comments">
    <div class="modal-comments-heading">
        <h3>Comentarios</h3>
        <span>{{ comments|length }}</span>
    </div>

    {% if app.user %}
        <form class="comment-form compact" method="post" action="{{ formAction }}">
            <input type="hidden" name="_token" value="{{ token }}">
            <textarea class="form-control" name="content" rows="3" placeholder="Escribe tu comentario" required></textarea>
            <button class="btn btn-dark action-button" type="submit">Comentar</button>
        </form>
    {% else %}
        <div class="login-callout compact">
            <p>Inicia sesion o crea una cuenta para comentar.</p>
            <div class="button-row">
                <a class="btn btn-dark action-button" href="{{ path('app_login') }}">Iniciar sesion</a>
                <a class="btn btn-outline-dark action-button" href="{{ path('app_register') }}">Crear cuenta</a>
            </div>
        </div>
    {% endif %}

    <div class="comment-list compact-list">
        {% for comment in comments %}
            <article>
                <strong>{{ comment.author }}</strong>
                <time>{{ comment.createdAt|date('d/m/Y H:i') }}</time>
                <p>{{ comment.content }}</p>
            </article>
        {% else %}
            <p class="no-results">Todavia no hay comentarios.</p>
        {% endfor %}
    </div>
</section>
